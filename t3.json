{
  "$schema": "https://t3.codes/schema/t3.json",
  "scripts": [
    {
      "name": "release(Windows x64)",
      "command": "cargo build --release --locked -p explorer --target x86_64-pc-windows-msvc",
      "icon": "build",
      "runOnWorktreeCreate": false
    },
    {
      "name": "installer(Windows x64)",
      "command": "pwsh -NoProfile -File scripts/build-windows-installer.ps1",
      "icon": "build",
      "runOnWorktreeCreate": false
    },
    {
      "name": "debug(Windows x64)",
      "command": "cargo build --locked -p explorer --target x86_64-pc-windows-msvc",
      "icon": "debug",
      "runOnWorktreeCreate": false
    },
    {
      "name": "debug(macOS native .app)",
      "command": "bash scripts/build-macos.sh debug",
      "icon": "build",
      "runOnWorktreeCreate": false
    },
    {
      "name": "release(macOS native .app)",
      "command": "bash scripts/build-macos.sh release",
      "icon": "build",
      "runOnWorktreeCreate": false
    },
    {
      "name": "launch(macOS debug .app)",
      "command": "bash scripts/build-macos.sh debug --launch",
      "icon": "play",
      "runOnWorktreeCreate": false
    }
  ]
}
