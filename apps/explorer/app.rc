// GPUI Fast loads icon resource 1 for the native window class.
1 ICON "assets/branding/skylis.ico"

1 VERSIONINFO
FILEVERSION SKYLIS_VERSION_MAJOR,SKYLIS_VERSION_MINOR,SKYLIS_VERSION_PATCH,0
PRODUCTVERSION SKYLIS_VERSION_MAJOR,SKYLIS_VERSION_MINOR,SKYLIS_VERSION_PATCH,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Skylis"
            VALUE "FileDescription", "Skylis File Manager"
            VALUE "ProductName", "Skylis"
            VALUE "FileVersion", SKYLIS_VERSION_STRING
            VALUE "ProductVersion", SKYLIS_VERSION_STRING
            VALUE "InternalName", "skylis"
            VALUE "OriginalFilename", "skylis.exe"
            VALUE "LegalCopyright", "Skylis contributors (Apache-2.0)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
